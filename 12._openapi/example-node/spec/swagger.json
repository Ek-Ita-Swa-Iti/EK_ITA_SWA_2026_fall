{
  "openapi": "3.0.3",
  "info": {
    "title": "Notes API",
    "version": "1.0.0",
    "description": "Notes-service fra session 9-11, skrevet ned som kontrakt i session 12."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "tags": [{ "name": "notes", "description": "Noter med titel og tekst" }],
  "paths": {
    "/v1/notes": {
      "get": {
        "tags": ["notes"],
        "summary": "Hent alle noter",
        "operationId": "listNotes",
        "responses": {
          "200": {
            "description": "Alle noter",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["notes"],
        "summary": "Opret en note",
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NewNote" } }
          }
        },
        "responses": {
          "201": {
            "description": "Noten er oprettet",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Note" } }
            }
          },
          "400": {
            "description": "Ugyldig JSON, eller title/body mangler",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "missingFields": { "value": { "error": "title and body are required" } },
                  "invalidJson": { "value": { "error": "Invalid JSON body" } }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/v1/notes/{id}": {
      "get": {
        "tags": ["notes"],
        "summary": "Hent én note",
        "operationId": "getNote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Notens numeriske id",
            "schema": { "type": "integer", "minimum": 1 },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Noten",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Note" } }
            }
          },
          "404": {
            "description": "Ingen note med det id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Note not found" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Note": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Welcome" },
          "body": { "type": "string", "example": "This note is read from MongoDB, not hardcoded." }
        }
      },
      "NewNote": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "example": "Indkøb" },
          "body": { "type": "string", "example": "Køb mælk" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Note not found" }
        }
      }
    },
    "responses": {
      "InternalError": {
        "description": "Uventet fejl, fx hvis databasen ikke svarer",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Internal server error" }
          }
        }
      }
    }
  }
}
