{
  "openapi": "3.0.3",
  "info": {
    "title": "Notes API",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {
    "/v1/notes": {
      "get": {
        "summary": "Hent alle noter",
        "responses": {
          "200": {
            "description": "Alle noter",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } } } }
          }
        }
      },
      "post": {
        "summary": "Opret en note",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NoteInput" } } }
        },
        "responses": {
          "201": { "description": "Noten er oprettet", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/notes/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": {
        "summary": "Hent én note",
        "responses": {
          "200": { "description": "Noten", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Erstat en note",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NoteInput" } } }
        },
        "responses": {
          "200": { "description": "Den opdaterede note", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Slet en note",
        "responses": {
          "204": { "description": "Noten er slettet" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Note": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "integer", "example": 2 },
          "title": { "type": "string", "example": "Espresso" },
          "body": { "type": "string", "example": "Maskinen skal afkalkes" }
        }
      },
      "NoteInput": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ugyldig JSON, eller title/body mangler",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Noten findes ikke",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
