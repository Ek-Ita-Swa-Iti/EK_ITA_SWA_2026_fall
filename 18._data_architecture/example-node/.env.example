# Kopiér denne fil til .env, og udfyld værdierne. .env må ALDRIG i Git.
# Find dem i Qdrant Cloud: https://cloud.qdrant.io → jeres cluster.
QDRANT_URL=https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
# Ét navn pr. par, hvis I deler cluster, fx notes-par3
QDRANT_COLLECTION=notes
